{
  "name": "hobart-warewash-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for Hobart commercial dishwashers (Hobart Cloud-to-Cloud / SmartConnect API). Works with Claude, ChatGPT and any MCP client: machines, active errors, temperatures, daily consumption, hygiene protocol, opt-in settings.",
  "keywords": [
    "hobart",
    "hobart-dishwasher",
    "warewash",
    "warewashing",
    "dishwasher",
    "commercial-dishwasher",
    "commercial-kitchen",
    "foodservice",
    "smartconnect",
    "visiotronic",
    "haccp",
    "iot",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "chatgpt",
    "openai",
    "ai",
    "llm",
    "ai-assistant"
  ],
  "homepage": "https://github.com/christophe77/hobart-warewash-mcp#readme",
  "bugs": {
    "url": "https://github.com/christophe77/hobart-warewash-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/hobart-warewash-mcp.git"
  },
  "license": "Apache-2.0",
  "author": "christophe77",
  "mcpName": "io.github.christophe77/hobart-warewash-mcp",
  "type": "module",
  "bin": {
    "hobart-warewash-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "README.fr.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin.js",
    "start:http": "node dist/bin.js --http",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
