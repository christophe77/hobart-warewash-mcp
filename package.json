{
  "name": "hobart-warewash-mcp",
  "version": "0.1.0",
  "description": "Unofficial MCP server for Hobart commercial dishwashers (Hobart Cloud-to-Cloud / SmartConnect API). Works with Claude, ChatGPT and any MCP client: machines, active errors, temperatures, daily consumption, hygiene protocol, opt-in settings.",
