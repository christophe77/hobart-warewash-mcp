# Hobart Cloud-to-Cloud account (OAuth2 password grant). Required.
HOBART_USERNAME=
HOBART_PASSWORD=

# Optional overrides — the defaults are the production Hobart C2C endpoints.
# HOBART_BASE_URL=https://cloud2cloud.smartconnect365.com/api/device/visio/c2c/v1.0
# HOBART_TOKEN_ENDPOINT=https://login.smartconnect365.com/itwfegcc.onmicrosoft.com/oauth2/v2.0/token?p=b2c_1_c2c_api_oauth_token
# HOBART_CLIENT_ID=9f86a02d-ac02-4b46-88cd-4e884ca29cb8
# HOBART_SCOPE=https://itwfegcc.onmicrosoft.com/ConnectedCloud/Machines.Read openId profile offline_access

# Write tools (register a machine, change settings) are off unless this is "true".
HOBART_ALLOW_WRITE=false

# HTTP mode only (--http): port, and the shared secret that guards /mcp.
# The secret is accepted as "Authorization: Bearer <secret>" or as the path /mcp/<secret>
# (ChatGPT and claude.ai custom connectors cannot send custom headers).
PORT=3333
MCP_HTTP_SECRET=
